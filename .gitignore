# ==============================================================================
# AI-WagyuSense .gitignore for GitHub Repository
# Keeps repo ultra-lightweight (< 20MB) for fast Jetson Orin Nano cloning
# ==============================================================================

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.log
.venv/
venv/
env/
ENV/

# Large Datasets & Archives (Keep local, do not push)
*.zip
*.tar
*.tar.gz
*.rar
*.pdf
AI-Model/รอทดสอบ/
AI-Model/dataset_T1_raw/
AI-Model/model2-efficientnet/dataset_T1/
AI-Model/model2-efficientnet/dataset_roi/
AI-Model/v8-seg/Version*/train/
AI-Model/v8-seg/Version*/valid/
AI-Model/v8-seg/Version*/test/
AI-Model/v8-seg/runs/
AI-Model/new_test_web_beef/
runs/

# Evaluation / Test Output Folders
AI-Model/ผลการทดสอบ_*
AI-Model/ผลการประเมิน_*
AI-Model/เปรียบเทียบ_*
live_captures/

# Intermediate / Heavy Models & Training Artifacts
yolo11n.pt
*.onnx
!weights/*.onnx
*.engine
AI-Model/model2-efficientnet/*.pth
AI-Model/model2-efficientnet/*.onnx
AI-Model/v8-seg/Version*/runs/
AI-Model/v8-seg/Version*/preview_verification/
AI-Model/v8-seg/Version*/test_results/
AI-Model/v8-seg/Version*/*.pt
AI-Model/v8-seg/Version*/*.jpg
AI-Model/v8-seg/Version*/*.png
AI-Model/v8-seg/Version*/*.webp
AI-Model/v8-seg/Version*/*.csv
AI-Model/v8-seg/Version*/README.roboflow.txt

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
